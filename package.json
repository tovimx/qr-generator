{
  "name": "qr-generator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:full": "npm run db:start && npm run dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "checkerrors": "npx tsc --noEmit && npx eslint src/ tests/ --ext .ts,.tsx",
    "validate:nextjs": "node scripts/validate-nextjs-architecture.js",
    "validate:all": "npm run checkerrors && npm run validate:nextjs",
    "impact-analysis": "scripts/architectural-impact-analysis.sh",
    "dependency-analysis": "scripts/dependency-graph-analysis.sh",
    "test:ssr": "node scripts/test-ssr.js",
    "test:multi-context": "scripts/multi-context-testing.sh",
    "test:enterprise": "npm run dependency-analysis && npm run test:multi-context",
    "postinstall": "prisma generate",
    "db:start": "brew services start postgresql@16",
    "db:stop": "brew services stop postgresql@16",
    "db:status": "brew services list | grep postgresql",
    "db:studio": "npx prisma studio",
    "db:reset": "npx prisma migrate reset",
    "db:push": "npx prisma db push",
    "db:migrate": "npx prisma migrate dev",
    "backfill:clients": "tsx scripts/backfill-default-client.ts",
    "backfill:projects": "tsx scripts/backfill-projects.ts",
    "verify:env": "node scripts/verify-env.js",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug"
  },
  "dependencies": {
    "@prisma/client": "^6.13.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.53.0",
    "@tanstack/react-query": "^5.85.5",
    "@tanstack/react-query-devtools": "^5.85.5",
    "dotenv": "^17.2.1",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.539.0",
    "next": "15.4.5",
    "prisma": "^6.13.0",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hot-toast": "^2.6.0",
    "react-qr-code": "^2.0.18",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.54.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.5",
    "@types/qrcode.react": "^3.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  }
}
