generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Use a direct connection string for migrations to avoid pgBouncer issues
  // Set DIRECT_DATABASE_URL in your environment to the non-pooled connection string
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  qrCodes      QRCode[]
  customThemes CustomTheme[]
  // Each user owns a single Client (tenant) in this initial design via Client.ownerUserId

  @@map("users")
}

model Client {
  id           String    @id @default(uuid())
  ownerUserId  String    @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  qrCodes      QRCode[]
  domains      Domain[]
  projects     Project[]

  @@map("clients")
}

model Domain {
  id        String   @id @default(uuid())
  clientId  String
  hostname  String   @unique
  type      String   @default("custom") // platform | subdomain | custom
  verified  Boolean  @default(false)
  primary   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  qrCodes   QRCode[]
  preferredByQRCodes QRCode[] @relation("QRCodePreferredDomain")

  @@index([clientId])
  @@map("domains")
}

model Project {
  id        String   @id @default(uuid())
  clientId  String
  name      String   @default("Default Project")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  qrCodes   QRCode[]

  @@index([clientId])
  @@map("projects")
}

model QRCode {
  id           String    @id @default(uuid())
  userId       String
  shortCode    String    @unique
  title        String    @default("My QR Code")
  isActive     Boolean   @default(true)
  position     Int       @default(0)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  redirectType String    @default("links")
  redirectUrl  String?
  logoSize     Int       @default(30)
  logoUrl      String?
  logoShape    String    @default("square")
  cornerRadius Int       @default(0)
  fgColor      String    @default("#000000")
  // Custom Design Fields
  themeId      String    @default("default")     @map("theme_id")
  primaryColor String    @default("#6366f1")     @map("primary_color")
  secondaryColor String  @default("#8b5cf6")     @map("secondary_color")
  backgroundType String  @default("gradient")    @map("background_type")
  backgroundValue String?                        @map("background_value")
  buttonStyle  String    @default("rounded")     @map("button_style")
  cardStyle    String    @default("floating")    @map("card_style")
  fontFamily   String    @default("inter")       @map("font_family")
  customCss    String?                           @map("custom_css")
  avatarUrl    String?                           @map("avatar_url")
  avatarStyle  String    @default("circle")      @map("avatar_style")
  description  String?
  socialLinks  Json?                             @map("social_links")
  customTitle  String?                           @map("custom_title")
  showTitle    Boolean   @default(true)          @map("show_title")
  links        Link[]
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  scans        Scan[]
  // Tenanting (Phase 1: optional, to be backfilled and enforced in Phase 2)
  clientId     String?
  client       Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  domainId     String?
  domain       Domain?   @relation(fields: [domainId], references: [id], onDelete: SetNull)
  // Project support (REQUIRED - every QR code must belong to a project)
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  // User preference for domain encoding
  preferredDomainId String?
  preferredDomain   Domain? @relation("QRCodePreferredDomain", fields: [preferredDomainId], references: [id], onDelete: SetNull)

  @@index([userId, deletedAt])
  @@index([userId, position])
  @@index([projectId, deletedAt])
  @@index([projectId, position])
  @@map("qr_codes")
}

model Link {
  id        String   @id @default(uuid())
  qrCodeId  String
  title     String
  url       String
  position  Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  qrCode    QRCode   @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  @@map("links")
}

model Scan {
  id        String   @id @default(uuid())
  qrCodeId  String
  userAgent String?
  ipHash    String?
  referer   String?
  createdAt DateTime @default(now())
  qrCode    QRCode   @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  @@index([qrCodeId, createdAt])
  @@map("scans")
}

model CustomTheme {
  id              String    @id @default(uuid())
  name            String
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Theme settings (matching DesignSettings interface)
  themeId         String    @default("custom")
  primaryColor    String
  secondaryColor  String
  backgroundType  String
  backgroundValue String?
  buttonStyle     String
  cardStyle       String    @default("floating")
  fontFamily      String
  customCss       String?
  avatarUrl       String?
  avatarStyle     String    @default("circle")
  description     String?
  socialLinks     Json?
  customTitle     String?
  showTitle       Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, name])
  @@map("custom_themes")
}
